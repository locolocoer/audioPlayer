{
  "name": "feiyu-music",
  "version": "1.5.6",
  "description": "飞鱼音乐 - WebDAV 桌面音乐播放器",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "chcp 65001 > nul && electron-vite preview --skipBuild",
    "package": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "version:bump": "node scripts/bump-version.mjs",
    "check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && vitest run && electron-vite build",
    "verify": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "chinese-s2t": "^1.0.0",
    "electron-updater": "^6.8.9",
    "music-metadata": "^11.15.0",
    "node-id3": "^0.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sql.js": "^1.11.0",
    "webdav": "^5.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
